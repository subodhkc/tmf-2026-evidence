# LogSense event environment template — copy to your own env file. NO values committed.
# Optional AI investigator provider (AI must never invent evidence):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Workspace / bundle roots (set automatically by the start scripts):
LOGSENSE_WORKSPACE=
LOGSENSE_EVENT_HOME=
# Optional local API bearer token:
LOGSENSE_API_TOKEN=
# MCP transport (stdio | streamable-http):
LOGSENSE_MCP_TRANSPORT=stdio
LOGSENSE_MCP_HOST=127.0.0.1
LOGSENSE_MCP_PORT=8766
