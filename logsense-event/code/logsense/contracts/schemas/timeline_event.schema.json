{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline Event",
  "type": "object",
  "properties": {
    "timelineEventId": {
      "type": "string"
    },
    "analysisRunId": {
      "type": "string"
    },
    "eventRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "actionGroupRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "semanticClass": {
      "type": "string"
    },
    "normalizedTime": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequenceIndex": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "orderingBasis": {
      "type": "string"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeQuality": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "timelineEventId",
    "analysisRunId",
    "semanticClass",
    "orderingBasis",
    "sourceRefs",
    "evidenceRefs",
    "timeQuality",
    "limitations"
  ],
  "$id": "https://logsense.local/schemas/timeline_event.schema.json"
}