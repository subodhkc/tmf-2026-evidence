    "evidenceRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "incidentSnapshotRef": {
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "notClaimed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "recoveryActionRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "recoveryId": {
      "type": "string"
    },
    "replayOrCancelCapability": {
      "type": "string"
    },
    "rollbackCompletedRefs": {
      "items": {
        "type": "string"
      },
