      "type": "string"
    },
    "storyId": {
      "type": "string"
    },
    "subjectRefs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "summary": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "whatEstablished": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
