{
  "$defs": {
    "CoverageCell": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/CoverageState"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "gapRefs": {
          "items": {
            "type": "string"
          },
          "title": "Gaprefs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "state"
      ],
      "title": "CoverageCell",
      "type": "object"
    },
    "CoverageState": {
      "enum": [
        "PRESENT",
        "PARTIAL",
        "MISSING",
        "CONTRADICTED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ],
      "title": "CoverageState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverageId": {
      "title": "Coverageid",
      "type": "string"
    },
    "actionGroupRef": {
      "title": "Actiongroupref",
      "type": "string"
    },
    "actionRequested": {
      "$ref": "#/$defs/CoverageCell"
    },
    "actionAuthorized": {
      "$ref": "#/$defs/CoverageCell"
    },
    "actionAccepted": {
      "$ref": "#/$defs/CoverageCell"
    },
    "actionApplied": {
      "$ref": "#/$defs/CoverageCell"
    },
    "actionConfirmed": {
      "$ref": "#/$defs/CoverageCell"
    },
    "localForensicLens": {
      "const": true,
      "default": true,
      "title": "Localforensiclens",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "coverageId",
    "actionGroupRef",
    "actionRequested",
    "actionAuthorized",
    "actionAccepted",
    "actionApplied",
    "actionConfirmed"
  ],
  "title": "ActionLifecycleCoverage",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logsense.local/schemas/action_lifecycle_coverage.schema.json"
}