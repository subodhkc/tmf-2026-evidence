{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parse Failure",
  "type": "object",
  "properties": {
    "parseFailureId": {
      "type": "string"
    },
    "analysisRunId": {
      "type": "string"
    },
    "artifactRef": {
      "type": "string"
    },
    "adapterId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordRef": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonCode": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "recoverable": {
      "type": "boolean"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "parseFailureId",
    "analysisRunId",
    "artifactRef",
    "reasonCode",
    "message",
    "recoverable",
    "evidenceRefs",
    "limitations"
  ],
  "$id": "https://logsense.local/schemas/parse_failure.schema.json"
}