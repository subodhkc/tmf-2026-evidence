{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logsense.local/schemas/forensic_case_projection.schema.json",
  "title": "Forensic Case Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion","caseId","scenarioId","states","transitions",
    "firstDeterministicDivergence","unresolvedRefs","componentDigests",
    "limitations","caseDigest"
  ],
  "properties": {
    "schemaVersion": {"type": "string"},
    "caseId": {"type": "string"},
    "scenarioId": {"type": "string"},
    "states": {
      "type": "array","minItems": 2,
      "items": {
        "type": "object","additionalProperties": false,
        "required": [
          "stateId","stateLabel","scenarioSequence","scenarioRunId","evidenceSetId",
          "analysisRunId","snapshotDigest","analysisPerimeterRef","evidenceRefs",
          "evidenceFrontierRefs","limitations"
        ],
        "properties": {
          "stateId":{"type":"string"},"stateLabel":{"type":"string"},
          "scenarioSequence":{"type":"integer","minimum":0},"scenarioRunId":{"type":"string"},
          "evidenceSetId":{"type":"string"},"analysisRunId":{"type":"string"},
          "snapshotDigest":{"type":"string"},"analysisPerimeterRef":{"type":"string"},
          "evidenceRefs":{"type":"array","items":{"type":"string"}},
          "evidenceFrontierRefs":{"type":"array","items":{"type":"string"}},
          "limitations":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "transitions": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":[
          "fromStateId","toStateId","availability","comparisonDigest","divergenceRefs",
          "divergenceKinds","dimensions","proofRefs","gapRefs","limitations"
        ],
        "properties":{
          "fromStateId":{"type":"string"},"toStateId":{"type":"string"},
          "availability":{"enum":["AVAILABLE","INCOMPARABLE"]},
          "comparisonDigest":{"type":["string","null"]},
          "divergenceRefs":{"type":"array","items":{"type":"string"}},
          "divergenceKinds":{"type":"array","items":{"type":"string"}},
          "dimensions":{"type":"array","items":{"type":"string"}},
          "proofRefs":{"type":"array","items":{"type":"string"}},
          "gapRefs":{"type":"array","items":{"type":"string"}},
          "limitations":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "firstDeterministicDivergence": {
      "anyOf":[
        {"type":"null"},
        {
          "type":"object","additionalProperties":false,
          "required":[
            "fromStateId","toStateId","divergenceRefs","divergenceKinds","dimensions",
            "proofRefs","gapRefs","limitations","rootCauseClaimed"
          ],
          "properties":{
            "fromStateId":{"type":"string"},"toStateId":{"type":"string"},
            "divergenceRefs":{"type":"array","items":{"type":"string"}},
            "divergenceKinds":{"type":"array","items":{"type":"string"}},
            "dimensions":{"type":"array","items":{"type":"string"}},
            "proofRefs":{"type":"array","items":{"type":"string"}},
            "gapRefs":{"type":"array","items":{"type":"string"}},
            "limitations":{"type":"array","items":{"type":"string"}},
            "rootCauseClaimed":{"const":false}
          }
        }
      ]
    },
    "unresolvedRefs":{"type":"array","items":{"type":"string"}},
    "componentDigests":{
      "type":"object","additionalProperties":false,
      "required":["snapshotDigests","transitionComparisonDigests"],
      "properties":{
        "snapshotDigests":{"type":"array","items":{"type":"string"}},
        "transitionComparisonDigests":{"type":"array","items":{"type":"string"}}
      }
    },
    "limitations":{"type":"array","items":{"type":"string"}},
    "caseDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}